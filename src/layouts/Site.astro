---
import profile from "../data/profile.json";

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const papersPage = title === "Papers";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.bio} />
    <title>{papersPage ? `Papers | ${profile.name}` : profile.name}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>{profile.name}</a>
      <nav aria-label="Main navigation">
        <a href={base} aria-current={!papersPage ? "page" : undefined}>Home</a>
        <a href={`${base}papers/`} aria-current={papersPage ? "page" : undefined}>Papers</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    color: #252321;
    background: #fcfbf8;
    font: 17px/1.58 Georgia, "Times New Roman", serif;
  }

  body { margin: 0; }
  a { color: #284c78; text-underline-offset: .18em; }
  a:hover { color: #132d50; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  .skip { position: absolute; left: 1rem; top: -6rem; background: #fcfbf8; padding: .5rem; }
  .skip:focus { top: 1rem; }

  .site-header, main {
    width: min(54rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    padding-block: 1.45rem;
    border-bottom: 1px solid #dcd6cc;
  }

  .brand { color: inherit; font-size: 1.44rem; text-decoration: none; }
  nav { display: flex; gap: 1.15rem; }
  nav a { color: inherit; text-decoration: none; }
  nav a:hover, nav a[aria-current] { text-decoration: underline; }

  main { padding-block: clamp(2rem, 5vw, 3.8rem) 4rem; }
  h1, h2 { font-weight: normal; line-height: 1.2; }
  h1 { margin: 0 0 .7rem; font-size: 2.05rem; }
  h2 { margin: 0 0 .65rem; font-size: 1.45rem; }
  p { margin: 0 0 .85rem; }

  .paper {
    display: grid;
    grid-template-columns: var(--paper-label-width, 8.5rem) minmax(0, 1fr);
    gap: .15rem 1rem;
    margin-block: 0 .85rem;
  }

  .paper p { margin: .16rem 0 0; }
  .paper-meta, .paper-authors, .paper-links { font-size: .87rem; color: #56514a; }
  .paper-meta { padding-top: .15rem; }
  .paper a { overflow-wrap: anywhere; }
  .paper-title { text-decoration: none; }
  .paper-title:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .site-header, main { width: calc(100% - 2.25rem); }
    .paper { grid-template-columns: minmax(0, 1fr); }
  }
</style>
