---
const { paper, compact = false } = Astro.props;
const dateLabel = paper.date
  ? new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" })
      .format(new Date(`${paper.date}-01T00:00:00Z`))
  : String(paper.year);
const links = [
  { label: "arXiv", url: paper.preprint },
  { label: "Blog", url: paper.blog },
  { label: "Code", url: paper.code },
].filter(({ url }) => url);
---
<article class="paper">
  <div class="paper-meta">
    {compact ? <time datetime={paper.date ?? String(paper.year)}>{dateLabel}</time> : paper.venue}
  </div>
  <div>
    <a class="paper-title" href={paper.url}>{paper.title}</a>
    {!compact && <p class="paper-authors">{paper.authors}</p>}
    {!compact && links.length > 0 && (
      <p class="paper-links">
        {links.map(({ label, url }, index) => (
          <>{index > 0 && " / "}<a href={url}>{label}</a></>
        ))}
      </p>
    )}
  </div>
</article>
